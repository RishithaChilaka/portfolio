# Resend (https://resend.com) — used by /api/send-email.js for the contact form.
# Create a free account, grab an API key from https://resend.com/api-keys,
# and set these as Environment Variables in your Vercel project (Settings > Environment Variables).
# This file is a reference only — Vite does NOT read these for the serverless function;
# they must be set directly in Vercel's dashboard (or via `vercel env add`).

RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=rishithareddych21@gmail.com
# Until you verify your own sending domain in Resend, use their shared sandbox sender:
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
